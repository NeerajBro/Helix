// HELIX - Enterprise Customer Support Platform
// Database schema with UUID PKs, audit fields, soft deletes, and indexes

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AgentAvailabilityStatus {
  ONLINE
  OFFLINE
  AWAY
  ON_BREAK
  BUSY
}

enum ConversationStatus {
  OPEN
  PENDING
  WAITING
  RESOLVED
  CLOSED
  TRANSFERRED
}

enum ConversationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
  CRITICAL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSenderType {
  CUSTOMER
  AGENT
  BOT
  SYSTEM
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum MessageContentType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  LOCATION
  TEMPLATE
  INTERACTIVE
}

enum QueueRoutingStrategy {
  ROUND_ROBIN
  LEAST_BUSY
  SKILL_BASED
  PRIORITY
  MANUAL
}

enum NotificationType {
  CONVERSATION_ASSIGNED
  CONVERSATION_TRANSFERRED
  SLA_BREACH
  MESSAGE_RECEIVED
  SYSTEM
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
  FAILED
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum TemplateStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum SalesforceSyncStatus {
  PENDING
  SYNCED
  FAILED
  NOT_APPLICABLE
}

enum BookingType {
  FLIGHT
  HOTEL
  PACKAGE
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ASSIGN
  TRANSFER
  RESOLVE
  CLOSE
  EXPORT
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH & RBAC
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  avatarUrl    String?    @map("avatar_url")
  phone        String?
  status       UserStatus @default(ACTIVE)
  departmentId String?    @map("department_id") @db.Uuid
  maxCapacity  Int        @default(5) @map("max_capacity")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  department            Department?              @relation(fields: [departmentId], references: [id])
  roles                 UserRole[]
  skills                UserSkill[]
  refreshTokens         RefreshToken[]
  assignedConversations Conversation[]           @relation("AssignedAgent")
  lockedConversations   Conversation[]           @relation("LockedByAgent")
  sentMessages          Message[]                @relation("AgentMessages")
  internalNotes         InternalNote[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  availability          AgentAvailability?
  assignments           ConversationAssignment[]
  csatSurveys           CsatSurvey[]

  @@index([email])
  @@index([departmentId])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  slug        String    @unique
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users       UserRole[]
  permissions RolePermission[]

  @@index([slug])
  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  slug        String    @unique
  module      String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  roles RolePermission[]

  @@index([slug])
  @@index([module])
  @@index([deletedAt])
  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// ORGANIZATION
// ─────────────────────────────────────────────────────────────────────────────

model Department {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  slug        String    @unique
  description String?
  color       String    @default("#1976d2")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users         User[]
  queues        Queue[]
  skills        DepartmentSkill[]
  conversations Conversation[]
  businessHours BusinessHour[]

  @@index([slug])
  @@index([isActive])
  @@index([deletedAt])
  @@map("departments")
}

model Skill {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users       UserSkill[]
  departments DepartmentSkill[]
  queues      Queue[]

  @@index([slug])
  @@index([deletedAt])
  @@map("skills")
}

model UserSkill {
  userId    String   @map("user_id") @db.Uuid
  skillId   String   @map("skill_id") @db.Uuid
  level     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@map("user_skills")
}

model DepartmentSkill {
  departmentId String   @map("department_id") @db.Uuid
  skillId      String   @map("skill_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([departmentId, skillId])
  @@map("department_skills")
}

model Queue {
  id               String               @id @default(uuid()) @db.Uuid
  name             String
  slug             String               @unique
  departmentId     String               @map("department_id") @db.Uuid
  skillId          String?              @map("skill_id") @db.Uuid
  routingStrategy  QueueRoutingStrategy @default(ROUND_ROBIN) @map("routing_strategy")
  priority         Int                  @default(0)
  slaFirstResponse Int?                 @map("sla_first_response")
  slaResolution    Int?                 @map("sla_resolution")
  isActive         Boolean              @default(true) @map("is_active")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  deletedAt        DateTime?            @map("deleted_at")

  department    Department     @relation(fields: [departmentId], references: [id])
  skill         Skill?         @relation(fields: [skillId], references: [id])
  conversations Conversation[]

  @@index([departmentId])
  @@index([slug])
  @@index([isActive])
  @@index([deletedAt])
  @@map("queues")
}

model BusinessHour {
  id           String   @id @default(uuid()) @db.Uuid
  departmentId String?  @map("department_id") @db.Uuid
  dayOfWeek    Int      @map("day_of_week")
  openTime     String   @map("open_time")
  closeTime    String   @map("close_time")
  timezone     String   @default("UTC")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department Department? @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
  @@index([dayOfWeek])
  @@map("business_hours")
}

model AgentAvailability {
  id        String                  @id @default(uuid()) @db.Uuid
  userId    String                  @unique @map("user_id") @db.Uuid
  status    AgentAvailabilityStatus @default(OFFLINE)
  reason    String?
  since     DateTime                @default(now())
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("agent_availability")
}

// ─────────────────────────────────────────────────────────────────────────────
// CUSTOMERS & CONVERSATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id              String    @id @default(uuid()) @db.Uuid
  phone           String    @unique
  name            String?
  email           String?
  avatarUrl       String?   @map("avatar_url")
  language        String    @default("en")
  timezone        String?
  isVip           Boolean   @default(false) @map("is_vip")
  metadata        Json?
  lastContactedAt DateTime? @map("last_contacted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  conversations Conversation[]
  bookings      Booking[]
  csatSurveys   CsatSurvey[]

  @@index([phone])
  @@index([email])
  @@index([isVip])
  @@index([deletedAt])
  @@map("customers")
}

model Conversation {
  id                String               @id @default(uuid()) @db.Uuid
  customerId        String               @map("customer_id") @db.Uuid
  whatsAppNumberId  String?              @map("whatsapp_number_id") @db.Uuid
  departmentId      String?              @map("department_id") @db.Uuid
  queueId           String?              @map("queue_id") @db.Uuid
  assignedAgentId   String?              @map("assigned_agent_id") @db.Uuid
  lockedById        String?              @map("locked_by_id") @db.Uuid
  lockedAt          DateTime?            @map("locked_at")
  status            ConversationStatus   @default(OPEN)
  priority          ConversationPriority @default(NORMAL)
  subject           String?
  aiSummary         String?              @map("ai_summary") @db.Text
  botHandled        Boolean              @default(true) @map("bot_handled")
  botTransferredAt  DateTime?            @map("bot_transferred_at")
  firstResponseAt   DateTime?            @map("first_response_at")
  resolvedAt        DateTime?            @map("resolved_at")
  closedAt          DateTime?            @map("closed_at")
  slaBreached       Boolean              @default(false) @map("sla_breached")
  whatsappExpiresAt DateTime?            @map("whatsapp_expires_at")
  sentimentScore    Float?               @map("sentiment_score")
  metadata          Json?
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  deletedAt         DateTime?            @map("deleted_at")

  customer       Customer                 @relation(fields: [customerId], references: [id])
  whatsAppNumber WhatsAppNumber?          @relation(fields: [whatsAppNumberId], references: [id])
  department     Department?              @relation(fields: [departmentId], references: [id])
  queue          Queue?                   @relation(fields: [queueId], references: [id])
  assignedAgent  User?                    @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  lockedBy       User?                    @relation("LockedByAgent", fields: [lockedById], references: [id])
  messages       Message[]
  tags           ConversationTag[]
  internalNotes  InternalNote[]
  assignments    ConversationAssignment[]
  salesforceCase SalesforceCase?
  csatSurvey     CsatSurvey?

  @@index([customerId])
  @@index([assignedAgentId])
  @@index([departmentId])
  @@index([queueId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("conversations")
}

model Message {
  id             String             @id @default(uuid()) @db.Uuid
  conversationId String             @map("conversation_id") @db.Uuid
  senderType     MessageSenderType  @map("sender_type")
  agentId        String?            @map("agent_id") @db.Uuid
  direction      MessageDirection
  contentType    MessageContentType @default(TEXT) @map("content_type")
  content        String             @db.Text
  status         MessageStatus      @default(PENDING)
  externalId     String?            @map("external_id")
  metadata       Json?
  sentAt         DateTime?          @map("sent_at")
  deliveredAt    DateTime?          @map("delivered_at")
  readAt         DateTime?          @map("read_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  deletedAt      DateTime?          @map("deleted_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent        User?        @relation("AgentMessages", fields: [agentId], references: [id])
  attachments  Attachment[]

  @@index([conversationId])
  @@index([agentId])
  @@index([createdAt])
  @@index([status])
  @@index([deletedAt])
  @@map("messages")
}

model Attachment {
  id         String    @id @default(uuid()) @db.Uuid
  messageId  String    @map("message_id") @db.Uuid
  fileName   String    @map("file_name")
  mimeType   String    @map("mime_type")
  fileSize   Int       @map("file_size")
  storageKey String    @map("storage_key")
  url        String?
  createdAt  DateTime  @default(now()) @map("created_at")
  deletedAt  DateTime? @map("deleted_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("attachments")
}

model Tag {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  color     String    @default("#757575")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  conversations ConversationTag[]

  @@index([deletedAt])
  @@map("tags")
}

model ConversationTag {
  conversationId String   @map("conversation_id") @db.Uuid
  tagId          String   @map("tag_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@map("conversation_tags")
}

model InternalNote {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  authorId       String   @map("author_id") @db.Uuid
  content        String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])

  @@index([conversationId])
  @@index([authorId])
  @@map("internal_notes")
}

model ConversationAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  agentId        String   @map("agent_id") @db.Uuid
  assignedById   String?  @map("assigned_by_id") @db.Uuid
  isAuto         Boolean  @default(false) @map("is_auto")
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agent        User         @relation(fields: [agentId], references: [id])

  @@index([conversationId])
  @@index([agentId])
  @@index([createdAt])
  @@map("conversation_assignments")
}

// ─────────────────────────────────────────────────────────────────────────────
// WHATSAPP & TEMPLATES
// ─────────────────────────────────────────────────────────────────────────────

model WhatsAppNumber {
  id           String    @id @default(uuid()) @db.Uuid
  phoneNumber  String    @unique @map("phone_number")
  displayName  String    @map("display_name")
  businessName String?   @map("business_name")
  isActive     Boolean   @default(true) @map("is_active")
  isDefault    Boolean   @default(false) @map("is_default")
  metadata     Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  conversations Conversation[]
  templates     Template[]
  campaigns     Campaign[]

  @@index([isActive])
  @@index([deletedAt])
  @@map("whatsapp_numbers")
}

model Template {
  id               String           @id @default(uuid()) @db.Uuid
  whatsAppNumberId String?          @map("whatsapp_number_id") @db.Uuid
  name             String
  slug             String           @unique
  category         TemplateCategory @default(UTILITY)
  language         String           @default("en")
  header           String?
  body             String           @db.Text
  footer           String?
  variables        Json?
  status           TemplateStatus   @default(DRAFT)
  externalId       String?          @map("external_id")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  whatsAppNumber WhatsAppNumber? @relation(fields: [whatsAppNumberId], references: [id])
  campaigns      Campaign[]

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
  @@map("templates")
}

model Campaign {
  id               String         @id @default(uuid()) @db.Uuid
  name             String
  templateId       String?        @map("template_id") @db.Uuid
  whatsAppNumberId String?        @map("whatsapp_number_id") @db.Uuid
  status           CampaignStatus @default(DRAFT)
  scheduledAt      DateTime?      @map("scheduled_at")
  startedAt        DateTime?      @map("started_at")
  completedAt      DateTime?      @map("completed_at")
  totalRecipients  Int            @default(0) @map("total_recipients")
  sentCount        Int            @default(0) @map("sent_count")
  deliveredCount   Int            @default(0) @map("delivered_count")
  failedCount      Int            @default(0) @map("failed_count")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  template       Template?           @relation(fields: [templateId], references: [id])
  whatsAppNumber WhatsAppNumber?     @relation(fields: [whatsAppNumberId], references: [id])
  recipients     CampaignRecipient[]

  @@index([status])
  @@index([scheduledAt])
  @@index([deletedAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id           String        @id @default(uuid()) @db.Uuid
  campaignId   String        @map("campaign_id") @db.Uuid
  phone        String
  variables    Json?
  status       MessageStatus @default(PENDING)
  sentAt       DateTime?     @map("sent_at")
  deliveredAt  DateTime?     @map("delivered_at")
  errorMessage String?       @map("error_message")
  createdAt    DateTime      @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([status])
  @@map("campaign_recipients")
}

// ─────────────────────────────────────────────────────────────────────────────
// INTEGRATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Booking {
  id          String      @id @default(uuid()) @db.Uuid
  customerId  String      @map("customer_id") @db.Uuid
  type        BookingType
  reference   String      @unique
  description String?
  status      String      @default("confirmed")
  startDate   DateTime?   @map("start_date")
  endDate     DateTime?   @map("end_date")
  amount      Decimal?    @db.Decimal(12, 2)
  currency    String?     @default("USD")
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([reference])
  @@index([type])
  @@index([deletedAt])
  @@map("bookings")
}

model SalesforceCase {
  id               String               @id @default(uuid()) @db.Uuid
  conversationId   String               @unique @map("conversation_id") @db.Uuid
  salesforceCaseId String?              @map("salesforce_case_id")
  caseNumber       String?              @map("case_number")
  subject          String?
  status           String?
  priority         String?
  syncStatus       SalesforceSyncStatus @default(PENDING) @map("sync_status")
  lastSyncedAt     DateTime?            @map("last_synced_at")
  syncError        String?              @map("sync_error")
  metadata         Json?
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([salesforceCaseId])
  @@index([syncStatus])
  @@map("salesforce_cases")
}

// ─────────────────────────────────────────────────────────────────────────────
// FEEDBACK & NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model CsatSurvey {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @unique @map("conversation_id") @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  agentId        String?  @map("agent_id") @db.Uuid
  rating         Int
  comment        String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id])
  agent        User?        @relation(fields: [agentId], references: [id])

  @@index([customerId])
  @@index([agentId])
  @@index([rating])
  @@index([createdAt])
  @@map("csat_surveys")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// SYSTEM
// ─────────────────────────────────────────────────────────────────────────────

model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@map("settings")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String?     @map("entity_id")
  oldValues  Json?       @map("old_values")
  newValues  Json?       @map("new_values")
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
