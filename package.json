{
  "name": "@helix/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "npx nx run-many -t serve -p api web --parallel=2",
    "api:serve": "npx nx serve api",
    "web:serve": "npx nx serve web",
    "build": "npx nx run-many -t build -p api web",
    "test": "npx nx run-many -t test",
    "lint": "npx nx run-many -t lint",
    "db:generate": "npx prisma generate --schema=apps/api/prisma/schema.prisma",
    "db:migrate": "npx prisma migrate dev --schema=apps/api/prisma/schema.prisma",
    "db:migrate:deploy": "npx prisma migrate deploy --schema=apps/api/prisma/schema.prisma",
    "db:seed": "npx ts-node apps/api/prisma/seed.ts",
    "db:studio": "npx prisma studio --schema=apps/api/prisma/schema.prisma",
    "db:reset": "npx prisma migrate reset --schema=apps/api/prisma/schema.prisma",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:infra": "docker compose up -d postgres redis minio minio-init"
  },
  "private": true,
