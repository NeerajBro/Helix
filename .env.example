# Database
DATABASE_URL=postgresql://helix:helix_secret@localhost:5432/helix?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=helix-dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=helix-dev-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=helix_minio
MINIO_SECRET_KEY=helix_minio_secret
MINIO_BUCKET=helix-attachments
MINIO_USE_SSL=false

# API
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# Frontend
API_URL=http://localhost:3000/api
WS_URL=http://localhost:3000

# Salesforce (mock adapter in development)
SALESFORCE_ENABLED=false
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# AI Bot (mock adapter in development)
AI_BOT_ENABLED=true
